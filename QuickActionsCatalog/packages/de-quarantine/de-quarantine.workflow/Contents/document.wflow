				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}
    set processedCount to 0
    if (count of input) &gt; 0 then
        set firstLine to (item 1 of input) as text
        if firstLine starts with "COUNT=" then
            set processedCount to (text 7 thru -1 of firstLine) as integer
        end if
    end if
    
    display dialog (processedCount as text) &amp; " item(s) complete." ¬
        buttons {"OK"} default button "OK" with title "xattr cleanup"
    return input
end run
</string>
